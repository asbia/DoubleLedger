{
    "name": "web-app",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
      "node": ">=20.0.0"
    },
    "dependencies": {
      "cypress": "^14.10.0",
      "axios": "^1.7.9",
      "clsx": "^1.1.1",
      "date-fns": "^2.30.0",
      "formik": "^2.2.9",
      "jwt-decode": "^3.1.2",
      "notistack": "^1.0.9",
      "prop-types": "^15.8.1",
      "query-string": "^7.1.1",
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "react-lazyload": "^3.2.0",
      "react-redux": "^8.1.0",
      "react-router-dom": "^6.9.0",
      "react-select": "^5.5.0",
      "react-slick": "^0.29.0",
      "react-spinkit": "^3.0.0",
      "react-table": "^7.8.0",
      "react-time-picker": "^4.6.0",
      "react-tiny-fab": "^5.0.2",
      "react-vis": "^1.11.7",
      "redux": "^4.2.1",
      "redux-thunk": "^2.4.2",
      "slick-carousel": "^1.8.1",
      "styled-components": "^5.3.6",
      "vite-plugin-env-compatible": "^2.0.1",
      "vite-tsconfig-paths": "^3.5.2",
      "yup": "^1.12.0"
    },
    "devDependencies": {
      "@babel/eslint-parser": "^7.22.5",
      "@vitejs/plugin-react": "^4.3.4",
      "babel-plugin-import": "^1.13.3",
      "cypress": "^14.10.0",
      "eslint": "^8.37.0",
      "eslint-plugin-jsx-a11y": "^6.7.1",
      "eslint-plugin-prettier": "^4.2.1",
      "eslint-plugin-react": "^7.32.1",
      "eslint-plugin-react-hooks": "^4.6.0",
      "http-server": "^14.1.1",
      "lint-staged": "^10.5.4",
      "prettier": "2.8.4",
      "react-app-rewired": "^2.1.8",
      "sass": "^1.62.0",
      "vite": "^6.0.11",
      "vite-plugin-svgr": "^4.3.0"
    },
    "scripts": {
      "start": "vite",
      "dev": "react-app-rewired start --env.NODE_ENV=development",
      "build": "vite build",
      "test": "react-scripts test",
      "cy": "cypress run",
      "cy:open": "cypress open",
      "eject": "react-scripts eject",
      "start-sw": "http-server ./build",
      "lint": "eslint .",
      "lint:fix": "eslint --fix .",
      "format": "prettier --write \"**/*.+(js|jsx|json|yml|yaml|css|md)\"",
      "doppler": "doppler run --command=\"npm start\""
    },
    "husky": {
      "hooks": {
        "pre-commit": "lint-staged"
      }
    },
    "lint-staged": {
      "*.+(js|jsx)": "eslint --fix",
      "*.+(json|css|md|yml|yaml)": "prettier --write"
    },
    "browserslist": [
      ">0.2%",
      "not dead",
      "not ie <= 11",
      "not op_mini all"
    ]
  }
  